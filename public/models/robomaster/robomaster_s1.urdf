  <joint name="intelligent_controller_joint" type="fixed">
    <origin xyz="-0.027 0.0 0.07" rpy="0 0 0"/>
    <parent link="blaster_link"/>
    <child link="intelligent_controller_link"/>
  </joint>
</robot>
