<?xml version="1.0"?>
<robot name="robomaster_s1">
  <!-- Compiled standard ROS URDF for DJI RoboMaster S1 (based on jeguzzi/robomaster_ros, Apache-2.0) -->
  <material name="armor_plastic">
    <color rgba="0.2277128 0.2277128 0.2277128 1.0"/>
  </material>
  <material name="chassis">
    <color rgba="0.0981132 0.0981132 0.0981132 1.0"/>
  </material>
  <material name="cover_plastic">
    <color rgba="0.2548322 0.2548322 0.2548322 0.35"/>
  </material>
  <material name="dark_plastic">
    <color rgba="0.0281746 0.0281746 0.0281746 1.0"/>
  </material>
  <material name="metal">
    <color rgba="0.08 0.09 0.11 1.0"/>
  </material>
  <material name="hit_detector">
    <color rgba="0.1697846 0.1697846 0.1697846 1.0"/>
  </material>
  <material name="led_light">
    <color rgba="0.0 0.7773585 0.7773583 1.0"/>
  </material>
  <material name="wheel_plastic">
    <color rgba="0.2739087 0.2739087 0.2739087 1.0"/>
  </material>
  <material name="gimbal_top">
    <color rgba="0.47861 0.47861 0.47861 1.0"/>
  </material>
  <material name="led_off">
    <color rgba="0.78118 0.78118 0.78118 1.0"/>
  </material>
  <material name="gimbal_side">
    <color rgba="0.04 0.045 0.055 1.0"/>
  </material>
  <material name="plastic">
    <color rgba="0.76578 0.76578 0.76578 1.0"/>
  </material>
  <material name="gimbal">
    <color rgba="0.12595 0.12595 0.12595 1.0"/>
  </material>
  <material name="gimbal_armor">
    <color rgba="0.06401 0.06401 0.06401 1.0"/>
  </material>
  <material name="intelligent_controller">
    <color rgba="0.8 0.8 0.8 1.0"/>
  </material>
  <material name="bolt">
    <color rgba="0.45 0.15 0.0 1.0"/>
  </material>

  <link name="base_link"/>

  <link name="chassis_base_link">
    <visual name="armor">
      <origin xyz="-0.0064553 -0.078141 0.0292877" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robomaster_description/meshes/armor.dae" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="armor_plastic"/>
    </visual>
    <visual name="battery">
      <origin xyz="-0.130336 -0.0018702 0.0174177" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robomaster_description/meshes/battery.dae" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="dark_plastic"/>
    </visual>
    <visual name="battery_pin_left">
      <origin xyz="-0.1158907 0.066115 0.0525243" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robomaster_description/meshes/battery_pin_left.dae" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="dark_plastic"/>
    </visual>
    <visual name="battery_pin_right">
      <origin xyz="-0.1158907 -0.0658844 0.0525243" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robomaster_description/meshes/battery_pin_right.dae" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="dark_plastic"/>
    </visual>
    <visual name="chassis">
      <origin xyz="-0.0059039 0.0004154 0.0527955" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robomaster_description/meshes/chassis.dae" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="chassis"/>
    </visual>
    <visual name="controller">
      <origin xyz="-0.1142288 -0.0006716 0.052675" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robomaster_description/meshes/controller.dae" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="dark_plastic"/>
    </visual>
    <visual name="controller_cover">
      <origin xyz="-0.0787757 -0.002522 0.0720827" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robomaster_description/meshes/controller_cover.dae" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="cover_plastic"/>
    </visual>
  </link>

  <joint name="chassis_base_joint" type="fixed">
    <origin xyz="0 0 0.03465" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="chassis_base_link"/>
  </joint>

  <!-- 4 Chassis Armor Hit Sensors + Team LED Bars -->
  <link name="front_hit_sensor_link">
    <visual name="front_hit_sensor">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/hit_sensor.dae" scale="1.0 1.0 1.0"/></geometry>
      <material name="hit_detector"/>
    </visual>
  </link>
  <link name="front_led_link">
    <visual name="front_led">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/led.dae" scale="1.0 1.0 1.0"/></geometry>
      <material name="led_light"/>
    </visual>
  </link>
  <joint name="front_hit_sensor_joint" type="fixed">
    <origin xyz="0.1569985 -0.0004276 0.0432862" rpy="0 0 0"/>
    <parent link="chassis_base_link"/>
    <child link="front_hit_sensor_link"/>
  </joint>
  <joint name="front_led_joint" type="fixed">
    <origin xyz="0.0087428 -0.0012841 3.75e-05" rpy="0 0 0"/>
    <parent link="front_hit_sensor_link"/>
    <child link="front_led_link"/>
  </joint>

  <link name="left_hit_sensor_link">
    <visual name="left_hit_sensor">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/hit_sensor.dae" scale="1.0 1.0 1.0"/></geometry>
      <material name="hit_detector"/>
    </visual>
  </link>
  <link name="left_led_link">
    <visual name="left_led">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/led.dae" scale="1.0 1.0 1.0"/></geometry>
      <material name="led_light"/>
    </visual>
  </link>
  <joint name="left_hit_sensor_joint" type="fixed">
    <origin xyz="-0.0024413 0.0886932 0.0298341" rpy="0 0 1.5707963"/>
    <parent link="chassis_base_link"/>
    <child link="left_hit_sensor_link"/>
  </joint>
  <joint name="left_led_joint" type="fixed">
    <origin xyz="0.0087428 -0.0012841 3.75e-05" rpy="0 0 0"/>
    <parent link="left_hit_sensor_link"/>
    <child link="left_led_link"/>
  </joint>

  <link name="rear_hit_sensor_link">
    <visual name="rear_hit_sensor">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/hit_sensor.dae" scale="1.0 1.0 1.0"/></geometry>
      <material name="hit_detector"/>
    </visual>
  </link>
  <link name="rear_led_link">
    <visual name="rear_led">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/led.dae" scale="1.0 1.0 1.0"/></geometry>
      <material name="led_light"/>
    </visual>
  </link>
  <joint name="rear_hit_sensor_joint" type="fixed">
    <origin xyz="-0.1581827 -0.0027864 0.0303668" rpy="0 0 3.1415927"/>
    <parent link="chassis_base_link"/>
    <child link="rear_hit_sensor_link"/>
  </joint>
  <joint name="rear_led_joint" type="fixed">
    <origin xyz="0.0087428 -0.0012841 3.75e-05" rpy="0 0 0"/>
    <parent link="rear_hit_sensor_link"/>
    <child link="rear_led_link"/>
  </joint>

  <link name="right_hit_sensor_link">
    <visual name="right_hit_sensor">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/hit_sensor.dae" scale="1.0 1.0 1.0"/></geometry>
      <material name="hit_detector"/>
    </visual>
  </link>
  <link name="right_led_link">
    <visual name="right_led">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/led.dae" scale="1.0 1.0 1.0"/></geometry>
      <material name="led_light"/>
    </visual>
  </link>
  <joint name="right_hit_sensor_joint" type="fixed">
    <origin xyz="-0.0024413 -0.0886932 0.0298341" rpy="0 0 -1.5707963"/>
    <parent link="chassis_base_link"/>
    <child link="right_hit_sensor_link"/>
  </joint>
  <joint name="right_led_joint" type="fixed">
    <origin xyz="0.0087428 -0.0012841 3.75e-05" rpy="0 0 0"/>
    <parent link="right_hit_sensor_link"/>
    <child link="right_led_link"/>
  </joint>

  <!-- 4 Mecanum Wheels -->
  <link name="front_left_wheel_link">
    <visual name="front_left_wheel_bolt">
      <origin xyz="0 0.0145 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.007" length="0.001"/></geometry>
      <material name="bolt"/>
    </visual>
    <visual name="front_left_wheel">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/wheel.dae" scale="1.0 1 1.0"/></geometry>
      <material name="wheel_plastic"/>
    </visual>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="0.1 0.1 0.01535" rpy="0 0 0"/>
    <parent link="chassis_base_link"/>
    <child link="front_left_wheel_link"/>
    <axis xyz="0 1.0 0"/>
  </joint>

  <link name="front_right_wheel_link">
    <visual name="front_right_wheel_bolt">
      <origin xyz="0 -0.0145 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.007" length="0.001"/></geometry>
      <material name="bolt"/>
    </visual>
    <visual name="front_right_wheel">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/wheel.dae" scale="1.0 -1 1.0"/></geometry>
      <material name="wheel_plastic"/>
    </visual>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="0.1 -0.1 0.01535" rpy="0 0 0"/>
    <parent link="chassis_base_link"/>
    <child link="front_right_wheel_link"/>
    <axis xyz="0 1.0 0"/>
  </joint>

  <link name="rear_left_wheel_link">
    <visual name="rear_left_wheel_bolt">
      <origin xyz="0 0.0145 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.007" length="0.001"/></geometry>
      <material name="bolt"/>
    </visual>
    <visual name="rear_left_wheel">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/wheel.dae" scale="1.0 -1 1.0"/></geometry>
      <material name="wheel_plastic"/>
    </visual>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <origin xyz="-0.1 0.1 0.01535" rpy="0 0 0"/>
    <parent link="chassis_base_link"/>
    <child link="rear_left_wheel_link"/>
    <axis xyz="0 1.0 0"/>
  </joint>

  <link name="rear_right_wheel_link">
    <visual name="rear_right_wheel_bolt">
      <origin xyz="0 -0.0145 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.007" length="0.001"/></geometry>
      <material name="bolt"/>
    </visual>
    <visual name="rear_right_wheel">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/wheel.dae" scale="1.0 1 1.0"/></geometry>
      <material name="wheel_plastic"/>
    </visual>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <origin xyz="-0.1 -0.1 0.01535" rpy="0 0 0"/>
    <parent link="chassis_base_link"/>
    <child link="rear_right_wheel_link"/>
    <axis xyz="0 1.0 0"/>
  </joint>

  <!-- 2-Axis Gimbal + Blaster Turret -->
  <link name="gimbal_base_link">
    <visual name="gimbal_base">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/gimbal_base.dae" scale="1.0 1.0 1.0"/></geometry>
      <material name="gimbal"/>
    </visual>
  </link>
  <joint name="gimbal_base_joint" type="fixed">
    <origin xyz="-0.002 0 0.118" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="gimbal_base_link"/>
  </joint>

  <link name="gimbal_link">
    <visual name="gimbal">
      <origin xyz="-2e-05 -0.001 0.03369" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/gimbal.dae" scale="1.0 1.0 1.0"/></geometry>
      <material name="gimbal"/>
    </visual>
    <visual name="gimbal_left_armor">
      <origin xyz="-0.00472 0.06418 0.07122" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/gimbal_left_armor.dae" scale="1.0 1.0 1.0"/></geometry>
      <material name="gimbal_armor"/>
    </visual>
    <visual name="gimbal_right_armor">
      <origin xyz="-0.00527 -0.06277 0.07314" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/gimbal_right_armor.dae" scale="1.0 1.0 1.0"/></geometry>
      <material name="gimbal_armor"/>
    </visual>
    <visual name="gimbal_side">
      <origin xyz="-0.00027 0.00034 0.08755" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/gimbal_side.dae" scale="1.0 1.0 1.0"/></geometry>
      <material name="gimbal_side"/>
    </visual>
  </link>
  <joint name="gimbal_joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="gimbal_base_link"/>
    <child link="gimbal_link"/>
    <axis xyz="0 0 1.0"/>
    <limit effort="0" velocity="0" lower="-4.363" upper="4.363"/>
  </joint>

  <link name="gimbal_left_led_link">
    <visual name="gimbal_left_led">
      <origin xyz="-0.02463 0 0.01615" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/gimbal_left_led.dae" scale="1.0 1.0 1.0"/></geometry>
      <material name="led_light"/>
    </visual>
  </link>
  <joint name="gimbal_left_led_joint" type="fixed">
    <origin xyz="0.00032 0.07079 0.08761" rpy="0 0 0"/>
    <parent link="gimbal_link"/>
    <child link="gimbal_left_led_link"/>
  </joint>

  <link name="gimbal_right_led_link">
    <visual name="gimbal_right_led">
      <origin xyz="-0.02463 0 0.01615" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/gimbal_right_led.dae" scale="1.0 1.0 1.0"/></geometry>
      <material name="led_light"/>
    </visual>
  </link>
  <joint name="gimbal_right_led_joint" type="fixed">
    <origin xyz="0.00032 -0.06941 0.08761" rpy="0 0 0"/>
    <parent link="gimbal_link"/>
    <child link="gimbal_right_led_link"/>
  </joint>

  <link name="blaster_link">
    <visual name="blaster_bug">
      <origin xyz="0.00029 -0.03927 0.00764" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/blaster_bug.dae" scale="0.7949 0.7949 0.7949"/></geometry>
      <material name="gimbal_armor"/>
    </visual>
    <visual name="blaster_gun">
      <origin xyz="0.03896 0.00326 -0.01071" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/blaster_gun.dae" scale="1.0 1.0 1.0"/></geometry>
    </visual>
    <visual name="blaster_magazin">
      <origin xyz="-0.02031 1e-05 0.02866" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/blaster_magazin.dae" scale="1.0 1.0 1.0"/></geometry>
      <material name="plastic"/>
    </visual>
    <visual name="blaster_top">
      <origin xyz="0.0014 0.00082 0.01703" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/blaster_top.dae" scale="1.0 1.0 1.0"/></geometry>
      <material name="gimbal_top"/>
    </visual>
  </link>
  <joint name="blaster_joint" type="revolute">
    <origin xyz="-0.00027 0.00034 0.08755" rpy="0 0 0"/>
    <parent link="gimbal_link"/>
    <child link="blaster_link"/>
    <axis xyz="0 1.0 0"/>
    <limit effort="0" velocity="0" lower="-0.5236" upper="0.4363"/>
  </joint>

  <link name="speaker_link">
    <visual name="speaker">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/speaker.dae" scale="1.0 1.0 1.0"/></geometry>
      <material name="dark_plastic"/>
    </visual>
  </link>
  <joint name="speaker_joint" type="fixed">
    <origin xyz="-0.01301 0.00691 -0.06117" rpy="0 0 0"/>
    <parent link="blaster_link"/>
    <child link="speaker_link"/>
  </joint>

  <!-- FPV Camera & Intelligent Controller mounted on Blaster -->
  <link name="camera_link">
    <visual name="camera">
      <origin xyz="7.15e-05 0 -0.0004056" rpy="0 -1.7453293 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/camera.dae" scale="1.0 1.0 1.0"/></geometry>
      <material name="metal"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <origin xyz="0.0728 0.0 0.0315" rpy="0 1.5708 0"/>
    <parent link="blaster_link"/>
    <child link="camera_link"/>
  </joint>

  <link name="intelligent_controller_link">
    <visual name="intelligent_controller">
      <origin xyz="0 0 -0.0095231" rpy="0 0 0"/>
      <geometry><mesh filename="package://robomaster_description/meshes/intelligent_controller.dae" scale="1.0 1.0 1.0"/></geometry>
      <material name="intelligent_controller"/>
