# Local-only closed playtest. Change the key for any shared environment.
ORIGIN=http://localhost:3000
PLAYTEST_KEY=replace-with-a-private-random-value
PUBLIC_ACCESS=0
LOCAL_HTTP=1
TEST_MAILBOX=1
# Allow one player to start private invite rooms while testing; ignored with PUBLIC_ACCESS=1.
# ALLOW_SOLO_PLAYTEST=1
PORT=3000
DATABASE_URL=postgresql://prism:prism-local@127.0.0.1:5432/prism
REDIS_URL=redis://127.0.0.1:6379
REDIS_NAMESPACE=prism
ONLINE_LIMIT=1000
# GAME_WORKERS=4
# SMTP_URL=smtps://user:password@mail.example.com:465
# SMTP_FROM=Prism Breach <playtest@example.com>
# MODERATOR_EMAILS=ops@example.com
# CHAT_FILTER_TERMS=comma,separated,terms
# PLAYTEST_HOLIDAYS=YYYY-MM-DD,YYYY-MM-DD
# MINOR_HOLIDAYS=YYYY-MM-DD,YYYY-MM-DD
# ELIGIBILITY_URL=https://operator.example.com/eligibility
# ELIGIBILITY_TOKEN=operator-issued-secret
# DRAIN_MATCHES=0
# For a local Caddy proxy. Compose's local-only port uses one trusted hop.
# TRUST_PROXY=loopback
