{
  "name": "spirit-realm-rift",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx server.ts",
    "start": "node --env-file-if-exists=.env server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/shared/*.test.ts backend/*.test.ts",
    "test:integration": "tsx --test test/*.integration.ts",
    "test:browser": "tsx --test test/browser.multiplayer.ts",
    "load:provision": "node ops/provision-capacity.ts",
    "load:test": "node ops/capacity.ts",
    "db:backup": "node --env-file-if-exists=.env ops/backup.ts",
    "db:restore": "node --env-file-if-exists=.env ops/restore.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "redis": "^6.3.1",
    "three": "^0.187.0",
    "urdf-loader": "^0.13.1",
    "vite": "^8.3.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
